<Window x:Class="ReportEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReportEditor.ViewModels"
        xmlns:views="clr-namespace:ReportEditor.Views"
        Title="{Binding WorkspaceTitle}"
        Icon="pack://application:,,,/Assets/checklist.png"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CreateProjectViewModel}">
            <views:CreateProjectView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Create Project.json..." Command="{Binding CreateWorkspaceCommand}"/>
                <MenuItem Header="_Open Project.json..." Command="{Binding OpenWorkspaceCommand}"/>
                <MenuItem Header="Save Project.json _As..." Command="{Binding SaveWorkspaceAsCommand}"/>
            </MenuItem>
        </Menu>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </DockPanel>
</Window>
