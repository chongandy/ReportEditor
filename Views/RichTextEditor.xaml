<UserControl x:Class="ReportEditor.Views.RichTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel x:Name="ToolBar" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="B" Click="Bold_Click" Padding="8,4" Margin="0,0,4,4" ToolTip="Bold"/>
            <Button Content="I" Click="Italic_Click" Padding="8,4" Margin="0,0,4,4" ToolTip="Italic"/>
            <Button Content="U" Click="Underline_Click" Padding="8,4" Margin="0,0,4,4" ToolTip="Underline"/>
            <Button Content="• List" Click="Bullets_Click" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="1. List" Click="Numbering_Click" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Left" Click="AlignLeft_Click" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Center" Click="AlignCenter_Click" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Right" Click="AlignRight_Click" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Undo" Click="Undo_Click" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Redo" Click="Redo_Click" Padding="8,4" Margin="0,0,4,4"/>
            <ComboBox x:Name="FontSizeBox" Width="72" Margin="0,0,4,4" VerticalAlignment="Center"
                      SelectionChanged="FontSizeBox_OnSelectionChanged"
                      ToolTip="Font size">
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="9"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="11"/>
                <ComboBoxItem Content="12"/>
                <ComboBoxItem Content="14" IsSelected="True"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="24"/>
                <ComboBoxItem Content="28"/>
                <ComboBoxItem Content="36"/>
            </ComboBox>
            <ComboBox x:Name="FontColorBox" Width="110" Margin="0,0,4,4" VerticalAlignment="Center"
                      SelectionChanged="FontColorBox_OnSelectionChanged"
                      ToolTip="Font color">
                <ComboBoxItem Tag="#1B2430" IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#1B2430" Margin="0,0,6,0"/>
                        <TextBlock Text="Black"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#9B1C1C">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#9B1C1C" Margin="0,0,6,0"/>
                        <TextBlock Text="Red"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#1F4E79">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#1F4E79" Margin="0,0,6,0"/>
                        <TextBlock Text="Blue"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#1B7A3D">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#1B7A3D" Margin="0,0,6,0"/>
                        <TextBlock Text="Green"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#C05621">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#C05621" Margin="0,0,6,0"/>
                        <TextBlock Text="Orange"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#6B21A8">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#6B21A8" Margin="0,0,6,0"/>
                        <TextBlock Text="Purple"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="12" Fill="#FFFFFF" Stroke="#C5CED8" Margin="0,0,6,0"/>
                        <TextBlock Text="White"/>
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>
            <Button Content="Link" Click="Link_Click" Padding="8,4" Margin="0,0,4,4" ToolTip="Insert a link to a file, folder, or website"/>
            <Button Content="LaTeX" Click="Latex_Click" Padding="8,4" Margin="0,0,4,4" ToolTip="Insert equation"/>
            <Button Content="Image" Click="Image_Click" Padding="8,4" Margin="0,0,4,4"/>
        </WrapPanel>
        <Border BorderBrush="#D5DDE6" BorderThickness="1" CornerRadius="4" Padding="8">
            <RichTextBox x:Name="Editor"
                         MinHeight="260"
                         BorderThickness="0"
                         AcceptsTab="True"
                         IsDocumentEnabled="True"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         Foreground="#1B2430"
                         CaretBrush="#1B2430"
                         VerticalScrollBarVisibility="Auto"
                         SelectionChanged="Editor_OnSelectionChanged"/>
        </Border>
    </DockPanel>
</UserControl>
