<UserControl x:Class="ReportEditor.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:ReportEditor.Views"
             xmlns:vm="clr-namespace:ReportEditor.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F4E79" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Create"
                            Command="{Binding CreateWorkspaceCommand}"
                            MinHeight="32"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            ToolTip="Create a new empty Project.json file"/>
                    <Button Content="Open"
                            Command="{Binding OpenWorkspaceCommand}"
                            MinHeight="32"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            ToolTip="Open a Project.json backup"/>
                    <Button Content="Save As"
                            Command="{Binding SaveWorkspaceAsCommand}"
                            MinHeight="32"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            ToolTip="Save a Project.json backup copy"/>
                    <Button Content="New project"
                            Command="{Binding NewProjectCommand}"
                            MinHeight="32"
                            Padding="14,6"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Overview — All Projects" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WorkspacePath}" Foreground="#B8C9DC" FontSize="11" Margin="0,2,8,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="PdfColumn" Width="360" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="#F7F9FC">
                <TextBlock DockPanel.Dock="Top" Text="Projects" FontWeight="SemiBold" Margin="12,12,12,4"/>
                <TreeView x:Name="ProjectTree"
                          ItemsSource="{Binding Tree}"
                          SelectedItemChanged="ProjectTree_OnSelectedItemChanged"
                          BorderThickness="0"
                          Background="Transparent"
                          Padding="8">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Title}" Margin="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Export"
                                                  Visibility="{Binding IsProject, Converter={StaticResource BoolToVis}}">
                                            <MenuItem Header="PDF"
                                                      Command="{Binding DataContext.ExportProjectPdfCommand, Source={x:Reference ProjectTree}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Word (DOCX)"
                                                      Command="{Binding DataContext.ExportProjectDocxCommand, Source={x:Reference ProjectTree}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </MenuItem>
                                        <Separator Visibility="{Binding IsProject, Converter={StaticResource BoolToVis}}"/>
                                        <MenuItem Header="Remove"
                                                  Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                  Command="{Binding DataContext.RemoveReportCommand, Source={x:Reference ProjectTree}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="#C5CED8"
                          Cursor="SizeWE"/>

            <Grid x:Name="CenterPanelGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ContentRow" Height="*" MinHeight="120"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition x:Name="TodoRow" Height="220" MinHeight="36"/>
                </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Padding="16" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Project overview -->
                    <StackPanel Visibility="{Binding ShowProjectPanel, Converter={StaticResource BoolToVis}}">
                        <hc:Card Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Edit"
                                                Command="{Binding BeginEditProjectCommand}"
                                                Visibility="{Binding IsEditingProject, Converter={StaticResource InverseBoolToVis}}"
                                                MinHeight="28"
                                                Padding="12,4"
                                                VerticalContentAlignment="Center"/>
                                        <Button Content="Save"
                                                Command="{Binding SaveProjectInfoCommand}"
                                                Style="{StaticResource ButtonPrimary}"
                                                Visibility="{Binding IsEditingProject, Converter={StaticResource BoolToVis}}"
                                                MinHeight="28"
                                                Padding="12,4"
                                                Margin="0,0,8,0"
                                                VerticalContentAlignment="Center"/>
                                        <Button Content="Cancel"
                                                Command="{Binding CancelEditProjectCommand}"
                                                Visibility="{Binding IsEditingProject, Converter={StaticResource BoolToVis}}"
                                                MinHeight="28"
                                                Padding="12,4"
                                                VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Project information" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Visibility="{Binding IsEditingProject, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Name" Foreground="#5B6775" Margin="0,4"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Name}" FontWeight="SemiBold" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Text="Charge Number" Foreground="#5B6775" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProject.ChargeNumber}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Text="Material Number" Foreground="#5B6775" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProject.MaterialNumber}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Text="Travel Number" Foreground="#5B6775" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProject.TravelNumber}" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Text="Customer" Foreground="#5B6775" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProject.Customer}" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Text="Project due date" Foreground="#5B6775" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProject.DueDate, StringFormat=d}" Margin="0,4"/>
                                </Grid>

                                <Grid Visibility="{Binding IsEditingProject, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Name" Foreground="#5B6775" VerticalAlignment="Center" Margin="0,4"/>
                                    <hc:TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Text="Charge Number" Foreground="#5B6775" VerticalAlignment="Center" Margin="0,4"/>
                                    <hc:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditChargeNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Text="Material Number" Foreground="#5B6775" VerticalAlignment="Center" Margin="0,4"/>
                                    <hc:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditMaterialNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Text="Travel Number" Foreground="#5B6775" VerticalAlignment="Center" Margin="0,4"/>
                                    <hc:TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditTravelNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Text="Customer" Foreground="#5B6775" VerticalAlignment="Center" Margin="0,4"/>
                                    <hc:TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditCustomer, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Text="Project due date" Foreground="#5B6775" VerticalAlignment="Center" Margin="0,4"/>
                                    <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding EditDueDate}" Margin="0,4" HorizontalAlignment="Left" Width="180"/>
                                </Grid>
                            </StackPanel>
                        </hc:Card>

                        <hc:Card Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Milestones" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding Milestones}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CellEditEnding="MilestoneGrid_OnCellEditEnding">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove"
                                                      Command="{Binding DataContext.RemoveMilestoneCommand, Source={x:Reference ProjectTree}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Milestone" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTemplateColumn Header="Due" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Due, StringFormat=d}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding Due, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="+ Add milestone" Command="{Binding AddMilestoneCommand}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </hc:Card>

                        <hc:Card>
                            <StackPanel>
                                <TextBlock Text="Follow up" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Tasks collected from submitted reports under this project."
                                           Foreground="#5B6775" FontSize="12" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding ProjectFollowUps}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50"/>
                                        <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="*"/>
                                        <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="140"/>
                                        <DataGridTextColumn Header="Due" Binding="{Binding Due, StringFormat=d}" Width="120"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                        <DataGridTemplateColumn Header="" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Source"
                                                            ToolTip="{Binding SourceReportTitle}"
                                                            Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Work"
                                                            Style="{StaticResource ButtonPrimary}"
                                                            Command="{Binding DataContext.WorkFollowUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </hc:Card>
                    </StackPanel>

                    <!-- Report editor -->
                    <DockPanel Visibility="{Binding ShowEditorPanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Report editor" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,0,0,12">
                                <Run Text="{Binding SelectedProject.Name, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding SelectedMilestone.Name, Mode=OneWay}"/>
                            </TextBlock>
                            <hc:TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource TextBoxExtend}"
                                        hc:InfoElement.Title="Report title"
                                        Margin="0,0,0,12"/>
                            <TextBlock Text="Linked to-do task" Foreground="#5B6775" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding TodoTaskOptions}"
                                      SelectedValue="{Binding DraftRelatedTodoId, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Task"
                                      IsEditable="False"
                                      Margin="0,0,0,12"
                                      MinHeight="32"
                                      VerticalContentAlignment="Center"
                                      ToolTip="Choose a task from the To-do List"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <hc:Card Margin="0,0,0,12"
                                     Visibility="{Binding ShowDraftFollowUps, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Follow up" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="DraftFollowUpGrid"
                                              ItemsSource="{Binding DraftFollowUps}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="180"
                                              VerticalScrollBarVisibility="Auto">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove"
                                                          Command="{Binding DataContext.RemoveDraftFollowUpCommand, Source={x:Reference ProjectTree}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Task" Binding="{Binding Task, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                            <DataGridTemplateColumn Header="Due" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Due, StringFormat=d}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <DatePicker SelectedDate="{Binding Due, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Status" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.StatusOptions, Source={x:Reference ProjectTree}}"
                                                                  SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="False"
                                                                  BorderThickness="0"
                                                                  Background="Transparent"
                                                                  VerticalContentAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="+ Add follow-up" Command="{Binding AddDraftFollowUpCommand}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </hc:Card>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Submit" Command="{Binding SubmitCommand}"
                                        Style="{StaticResource ButtonPrimary}"
                                        MinHeight="40"
                                        MinWidth="100"
                                        Padding="20,10"
                                        Margin="0,0,8,0"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        HorizontalContentAlignment="Center"/>
                                <Button Content="Cancel" Command="{Binding CancelCommand}"
                                        MinHeight="40"
                                        MinWidth="100"
                                        Padding="20,10"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <hc:Card Margin="0,0,0,12" MinHeight="280" MaxHeight="420">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Write report" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <views:RichTextEditor x:Name="Editor" VerticalAlignment="Stretch"/>
                            </DockPanel>
                        </hc:Card>
                    </DockPanel>
                </Grid>
            </ScrollViewer>

                <GridSplitter x:Name="TodoSplitter"
                              Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              Background="#C5CED8"
                              Cursor="SizeNS"
                              MouseDoubleClick="TodoSplitter_OnMouseDoubleClick"/>

                <Expander x:Name="TodoExpander"
                          Grid.Row="2"
                          Header="To-do List"
                          IsExpanded="True"
                          ExpandDirection="Down"
                          Margin="8,0,8,8"
                          Background="White"
                          BorderBrush="#D5DDE6"
                          BorderThickness="1"
                          Padding="8"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          Expanded="TodoExpander_OnExpanded"
                          Collapsed="TodoExpander_OnCollapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="+ Add to-do"
                                    Command="{Binding AddTodoItemCommand}"
                                    HorizontalAlignment="Left"
                                    MinHeight="28"
                                    Padding="12,4"
                                    Margin="0,0,8,0"/>
                            <Button Content="Remove"
                                    Command="{Binding RemoveSelectedTodoCommand}"
                                    HorizontalAlignment="Left"
                                    MinHeight="28"
                                    Padding="12,4"/>
                        </StackPanel>
                        <DataGrid x:Name="TodoGrid"
                                  ItemsSource="{Binding TodoItems}"
                                  SelectedItem="{Binding SelectedTodoItem, UpdateSourceTrigger=PropertyChanged}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  MinHeight="80"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove"
                                              Command="{Binding DataContext.RemoveTodoItemCommand, Source={x:Reference ProjectTree}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Resources>
                                <Style x:Key="PriorityComboStyle" TargetType="ComboBox">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                            <Setter Property="Background" Value="#E53E3E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                            <Setter Property="Background" Value="#DD6B20"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="Low">
                                            <Setter Property="Background" Value="#38A169"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="PriorityItemStyle" TargetType="ComboBoxItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="High">
                                            <Setter Property="Background" Value="#E53E3E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Medium">
                                            <Setter Property="Background" Value="#DD6B20"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Low">
                                            <Setter Property="Background" Value="#38A169"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Task" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Task, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Project" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ProjectOptions, Source={x:Reference ProjectTree}}"
                                                      SelectedValue="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Name"
                                                      IsEditable="False"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Priority" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.TodoPriorityOptions, Source={x:Reference ProjectTree}}"
                                                      SelectedItem="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      Style="{StaticResource PriorityComboStyle}"
                                                      ItemContainerStyle="{StaticResource PriorityItemStyle}"
                                                      VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Due date" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.TodoStatusOptions, Source={x:Reference ProjectTree}}"
                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Expander>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="#C5CED8"
                          Cursor="SizeWE"/>

            <Expander x:Name="PdfExpander"
                      Grid.Column="4"
                      Header="PDF"
                      ExpandDirection="Left"
                      IsExpanded="True"
                      Expanded="PdfExpander_OnExpanded"
                      Collapsed="PdfExpander_OnCollapsed"
                      Background="#F7F9FC"
                      BorderBrush="#D5DDE6"
                      BorderThickness="1"
                      Padding="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
                <views:PdfViewerPanel MinWidth="220"/>
            </Expander>
        </Grid>
    </DockPanel>
</UserControl>
