<UserControl x:Class="ReportEditor.Views.PdfPageSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White"
            BorderBrush="#C5CED8"
            BorderThickness="1"
            Padding="4"
            HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{Binding Label}"
                       Foreground="#5B6775"
                       FontSize="11"
                       Margin="0,0,0,4"/>
            <Grid x:Name="PageHost"
                  MaxWidth="900"
                  Cursor="Cross"
                  MouseLeftButtonDown="PageHost_OnMouseLeftButtonDown"
                  MouseMove="PageHost_OnMouseMove"
                  MouseLeftButtonUp="PageHost_OnMouseLeftButtonUp"
                  MouseLeave="PageHost_OnMouseLeave"
                  SizeChanged="PageHost_OnSizeChanged">
                <Image x:Name="PageImage"
                       Source="{Binding Image}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
